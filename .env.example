# Optional settings. To use them: copy this file to ".env" (same folder) and remove the "#" in front of a line.
# LiteForeFlow reads ".env" automatically when it starts.

# PORT=3000
# ALLOW_SIGNUP=false           # set to false after you created your account, so nobody else can register
# BLOCK_PRIVATE_NETWORK=true   # recommended if other people use your server
# SAVE_SUCCESS_DATA=false      # keep less history (saves disk space)
# LITEFOREFLOW_SECRET=change-me-long-random-string   # back this up: it unlocks your saved credentials
