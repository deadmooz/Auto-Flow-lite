{
  "name": "liteforeflow",
  "version": "0.2.0",
  "description": "A tiny, self-hosted workflow automation tool. One command to start, no Docker.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "prestart": "node scripts/preflight.cjs",
    "start": "node --max-semi-space-size=2 --max-old-space-size=192 server/src/index.js",
    "dev": "node --watch server/src/index.js",
    "worker": "node --max-semi-space-size=2 --max-old-space-size=192 server/src/worker.js",
    "test": "node --test --test-concurrency=1 server/test/api.test.js server/test/schedule.test.mjs server/test/plugins.test.mjs",
    "qa": "node server/test/qa/qa.mjs",
    "plugin:new": "node scripts/new-plugin.cjs",
    "scale-up": "npm install --save-optional pg@^8.13.1 bullmq@^6.4.2 ioredis@^6.0.0",
    "build": "npm install --prefix web && npm run build --prefix web",
    "dev:web": "npm install --prefix web && npm run dev --prefix web"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16"
  },
  "optionalDependencies": {
    "isolated-vm": "^7.0.1"
  }
}
